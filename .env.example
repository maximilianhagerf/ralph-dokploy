# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public HTTPS URL Telegram will POST webhook events to (must include /webhook path)
RALPH_WEBHOOK_URL=https://your-domain.example.com/webhook

# Port the bot listens on inside the container (default: 8443)
PORT=8443

# Comma-separated Telegram user IDs allowed to interact with the bot
RALPH_ALLOWED_USERS=123456789,987654321

# Comma-separated GitHub repository URLs the bot is allowed to operate on
RALPH_REPOS=https://github.com/owner/repo1,https://github.com/owner/repo2

# GitHub Personal Access Token with repo scope (used for API calls and gh CLI auth)
GITHUB_TOKEN=ghp_your_github_pat_here

# Anthropic API key — provide this OR CLAUDE_CREDENTIALS_B64, not both required
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# Claude Pro/Max subscription credentials — alternative to ANTHROPIC_API_KEY
# 1. Run: claude auth login  (on your local machine)
# 2. Run: cat ~/.claude/.credentials.json | base64  (copy output)
# 3. Paste the base64 string here
# CLAUDE_CREDENTIALS_B64=

# Claude model used by ralph-once.sh (optional; defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
